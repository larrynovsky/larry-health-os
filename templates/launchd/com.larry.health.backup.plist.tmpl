<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.larry.health.backup (Studio variant) — ежедневный SQLite backup в 03:00 local.
  
  ВАЖНО: на MacBook стоит одноимённый plist, который делает только git commit.
  Studio делает только sqlite-backup. Разделено после BUG-BACKUP-DEAD (2026-05-09).
  
  Источник: backup_studio.sh
  Логи: ~/health/logs/backup.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.larry.health.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{REPO}}/backup_studio.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HEALTH_DATA_DIR</key>
        <string>{{DATA}}</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{DATA}}/logs/backup.log</string>
    <key>StandardErrorPath</key>
    <string>{{DATA}}/logs/backup.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
