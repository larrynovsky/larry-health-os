  "cards": [
    {
      "dot": "violet",
      "title": "A loop, not a feed",
      "items": [
        "A confirmed hypothesis becomes a protocol: what to do, what to measure, when to check",
        "You forward the doctor's answer to the bot — it changes the hypothesis instead of sitting in a chat",
        "A question closes only with a written answer, not a tick"
      ]
    },
    {
      "dot": "rose",
      "title": "Distrusts itself",
      "items": [
        "Only what you confirmed enters the database",
        "A link reaches you only after passing the chance check",
        "No threshold in a document — a loud refusal, not a guess",
        "Unchanged things are not repeated; silence is the normal state"
      ]
    },
    {
      "dot": "amber",
      "title": "What leaves the machine",
      "items": [
        "Every model call goes through one exit to the chosen provider: Anthropic, OpenAI or Gemini",
        "Messages go through Telegram",
        "Genome variant positions go to annotation services, without your name"
      ]
    },
    {
      "dot": "emerald",
      "title": "Around it",
      "items": [
        "Docker: bot, file intake, dashboard and a scheduler of ~25 jobs",
        "Backup every night, a snapshot before anything risky",
        "Several people — each with their own database, bot and secrets",
        "Fixes its own technical faults; never changes your data on its own"
      ]
    }
  ]
