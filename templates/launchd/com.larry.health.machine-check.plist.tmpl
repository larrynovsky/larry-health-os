<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.larry.health.machine-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{REPO}}/scripts/machine_check.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Ежедневно 07:40: до монитора владельца в контейнере (07:50) — он читает этот результат
         из журналов хоста. Хост Мака, не контейнер: предмет проверок — сама машина Studio
         (launchd, снимки MacBook, экспозиция). Живость судит check_machine_judge_alive у владельца. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/health-machine-check.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/health-machine-check.log</string>
</dict>
</plist>
