<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.larry.health.agent-mail-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.11</string>
        <string>{{REPO}}/scripts/agent_mail_bridge.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Мост почты агентов (нить agent-post, 05.11): каталоги тенантов health ↔ почтамт infra.
         Хост Мака, не контейнер: почтамт живёт на хосте и не удостоверяет отправителя, поэтому
         контейнеру его не дают. Раз в 60 с; живость — файл alive, судит check_agent_mail_bridge_alive. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/health-agent-mail-bridge.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/health-agent-mail-bridge.log</string>
</dict>
</plist>
