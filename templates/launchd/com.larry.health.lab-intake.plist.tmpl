<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.larry.health.lab-intake</string>
    <key>ProgramArguments</key>
    <array><string>{{PYTHON}}</string><string>{{REPO}}/lab_intake_watcher.py</string></array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HEALTH_DATA_DIR</key><string>{{DATA}}</string>
    </dict>
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>{{REPO}}/logs/lab_intake.log</string>
    <key>StandardErrorPath</key><string>{{REPO}}/logs/lab_intake_err.log</string>
    <key>WorkingDirectory</key><string>{{REPO}}</string>
    <key>ThrottleInterval</key><integer>30</integer>
</dict>
</plist>
