    echo "⚠️  ПРАВА В КАТАЛОГЕ СЕКРЕТОВ ЭТОЙ МАШИНЫ (канон 700/600):"
    echo "$_PERMS" | sed 's/^/     /'
    echo "     chmod 600 <файл> / chmod 700 <каталог>. Integrity видит только Studio."
fi

# ── Ротация ЭТОЙ машины жива? (2026-09-02) ───────────────────────────────────
# Находка: check_logrotate_liveness читает ЛОКАЛЬНУЮ квитанцию, а integrity гоняется
# на Studio — смерть агента на MacBook оттуда не видна. Здесь единственное место,
# исполняемое на машине-писателе кода. WARN, не блок: состояние launchd — не вина
# коммита, а датчик, блокирующий работу из-за чужого агента, выучат обходить (§13).
_ROT=$("$PYTHON" - <<'PYEOF' 2>/dev/null
try:
    import log_rotate
    r = log_rotate.receipt_status()
    if not r["exists"]:
        print("квитанции ротации нет — агент com.larry.health.logrotate не запускался")
    elif r["age_h"] >= 24:
        print(f"ротация молчит {r['age_h']:.0f}ч при интервале 30 мин — агент не бежит")
    elif not r["selftest_ok"]:
        print("последний прогон не дошёл до `selftest ok` — смотри logs/logrotate_err.log")
except Exception as e:
    print(f"датчик живости ротации не отработал: {e}")
PYEOF
)
if [[ -n "$_ROT" ]]; then
    echo ""
    echo "⚠️  РОТАЦИЯ ЛОГОВ НА ЭТОЙ МАШИНЕ:"
    echo "$_ROT" | sed 's/^/     /'
    echo "     launchctl print gui/\$(id -u)/com.larry.health.logrotate"
fi

